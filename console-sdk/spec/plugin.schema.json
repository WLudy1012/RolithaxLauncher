{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rolithax Console Plugin Manifest (SDK 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sdkVersion", "server"],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]{0,63}(\\.[a-z][a-z0-9-]{0,63})+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){2}$"
    },
    "sdkVersion": { "const": 1 },
    "server": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
  }
}
