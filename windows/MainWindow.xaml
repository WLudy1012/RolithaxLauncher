<Window
    x:Class="Rolithax.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <TitleBar x:Name="AppTitleBar" Title="Rolithax" Subtitle="远端管理">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Rolithax.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <ProgressRing x:Name="BusyIndicator" Width="20" Height="20" IsActive="False" HorizontalAlignment="Right" Margin="0,0,154,0" />
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        ExpandedModeThresholdWidth="940" CompactModeThresholdWidth="650"
                        OpenPaneLength="228">
            <NavigationView.PaneHeader>
                <StackPanel Margin="8,0,12,12" Spacing="2">
                    <TextBlock Text="Rolithax 中心" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PaneStatus" Text="尚未连接" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNav" Tag="overview" Content="概览" Icon="Home" />
                <NavigationViewItem Tag="instances" Content="服务器" Icon="Library" />
                <NavigationViewItem Tag="connections" Content="连接管理" Icon="Link" />
                <NavigationViewItem Tag="users" Content="用户管理" Icon="People" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="设置" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid RowDefinitions="Auto,*" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <InfoBar x:Name="Feedback" Margin="24,12,24,0" />
                <Grid x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
