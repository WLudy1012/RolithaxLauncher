<Window
    x:Class="Rolithax.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <Border x:Name="SolidWindowBackground" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Border x:Name="MicaAltNavigationLayer" Grid.Row="1" Visibility="Collapsed"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <TitleBar x:Name="AppTitleBar" Title="Rolithax" Subtitle="远端管理">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Rolithax.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <ProgressRing x:Name="BusyIndicator" Width="16" Height="16" Margin="8,0" IsActive="False"
                              AutomationProperties.Name="正在处理请求" />
            </TitleBar.RightHeader>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
                        AutomationProperties.Name="远端管理"
                        ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="560"
                        CompactPaneLength="56" OpenPaneLength="220">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel x:Name="NavigationContext" Margin="16,16,12,12" Spacing="2">
                    <TextBlock Text="远端管理" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PaneStatus" Text="尚未连接" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNav" Tag="overview" Content="概览" Icon="Home" ToolTipService.ToolTip="概览" />
                <NavigationViewItem Tag="instances" Content="服务器" Icon="Library" ToolTipService.ToolTip="服务器" />
                <NavigationViewItem Tag="connections" Content="连接管理" Icon="Link" ToolTipService.ToolTip="连接管理" />
                <NavigationViewItem Tag="users" Content="用户管理" Icon="People" ToolTipService.ToolTip="用户管理" />
                <NavigationViewItem Tag="settings" Content="设置" Icon="Setting" ToolTipService.ToolTip="设置" />
            </NavigationView.MenuItems>
            <Border x:Name="WorkspaceSurface" Style="{ThemeResource RolithaxWorkspaceSurfaceStyle}" Margin="10,2,10,10">
                <Grid RowDefinitions="Auto,*">
                    <InfoBar x:Name="Feedback" Margin="24,12,24,0" />
                    <Grid x:Name="PageHost" Grid.Row="1" />
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
